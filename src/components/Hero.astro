---
import { Image } from "astro:assets";

import Logo from "./Logo.astro";
import heroField from "../assets/hero-field.jpg";
---

<section class='hero'>
  <!-- vivid aerial drone photo dissolving into the green page -->
  <div class='hero-photo'>
    <Image
      src={heroField}
      alt='Aerial view of the Siren fields in Tondela, Portugal'
      widths={[768, 1280, 1920]}
      sizes='100vw'
      loading='eager'
      fetchpriority='high'
    />
    <div class='hero-tint'></div>
  </div>

  <!-- hero copy, sitting over the field below the horizon -->
  <div class='hero-copy'>
    <p class='hero-eyebrow'>Tondela · Portugal</p>
    <h1>The farm is the instrument.</h1>
    <p class='hero-lede'>
      Siren builds agricultural intelligence — DNA-guided cultivar selection and
      field-scale sensing — and trains it on medical cannabis in the Dão: a crop
      valuable enough to fund the science, needed enough to matter, and the best
      biological model we could have chosen.
    </p>
    <div class='hero-actions'>
      <a class='hero-cta primary' href='/why/'>Why cannabis?</a>
      <a class='hero-cta' href='/science/'>See the science</a>
    </div>
  </div>

  <!-- dark leaf mark below the copy — its lower branches tuck behind the cards -->
  <div class='hero-leaf'>
    <Logo tone='dark' class='hero-leaf-mark' />
  </div>
</section>

<style>
  /* no overflow:hidden here — the leaf must run past the section
     and tuck behind the frosted cards below */
  .hero {
    position: relative;
    width: 100%;
  }

  .hero-photo {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    /* extend under the iOS status bar (viewport-fit=cover) */
    height: calc(clamp(560px, 49.2vw, 850px) + env(safe-area-inset-top, 0px));
    z-index: 0;
    overflow: hidden;
    pointer-events: none;
  }
  .hero-photo img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center 60%;
    display: block;
  }
  /* uniform green wash + soft top-center haze + curved bottom dissolve */
  .hero-tint {
    position: absolute;
    inset: 0;
    background:
      radial-gradient(
        ellipse 85% 95% at 50% 0%,
        rgba(47, 99, 87, 0) 45%,
        rgba(47, 99, 87, 0.55) 63%,
        rgba(47, 99, 87, 0.9) 80%,
        #2f6357 94%
      ),
      radial-gradient(
        ellipse 68% 64% at 50% 0%,
        rgba(64, 135, 119, 0.3) 0%,
        rgba(64, 135, 119, 0) 72%
      ),
      linear-gradient(rgba(47, 99, 87, 0.4), rgba(47, 99, 87, 0.4));
  }

  .hero-copy {
    position: relative;
    z-index: 1;
    max-width: 1080px;
    margin: 0 auto;
    padding: calc(clamp(300px, 22vw, 400px) + env(safe-area-inset-top, 0px)) 24px 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
  }
  .hero-eyebrow {
    margin: 0 0 clamp(14px, 1.4vw, 20px);
    font-size: clamp(12px, 1.05vw, 15px);
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: var(--color-putty);
    opacity: 0.85;
  }
  .hero-copy h1 {
    margin: 0;
    font-size: clamp(38px, 5.4vw, 84px);
    line-height: 1.08;
    color: var(--color-putty);
    text-wrap: balance;
  }
  .hero-lede {
    margin: clamp(16px, 1.5vw, 26px) 0 0;
    max-width: 30em;
    font-size: clamp(16px, 1.55vw, 24px);
    line-height: 1.45;
    color: var(--color-white);
    text-wrap: pretty;
  }

  .hero-actions {
    margin-top: clamp(26px, 2.6vw, 40px);
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 12px;
  }
  .hero-cta {
    display: inline-flex;
    align-items: center;
    padding: 0.75rem 1.6rem;
    border-radius: 999px;
    border: 1px solid rgba(240, 207, 135, 0.55);
    font-size: clamp(15px, 1.15vw, 18px);
    line-height: 1.5;
    color: var(--color-rum-swizzle);
    text-decoration: none;
    white-space: nowrap;
    transition:
      background 250ms ease,
      color 250ms ease,
      border-color 250ms ease;
  }
  .hero-cta:hover {
    border-color: transparent;
    background: var(--color-rum-swizzle);
    color: var(--color-te-papa-green);
  }
  .hero-cta.primary {
    border-color: transparent;
    background: var(--color-saffron-mango);
    color: var(--color-te-papa-green);
  }
  .hero-cta.primary:hover {
    background: var(--color-putty);
  }

  .hero-leaf {
    position: relative;
    z-index: 1;
    display: flex;
    justify-content: center;
    margin-top: clamp(20px, 3.5vw, 60px);
    margin-bottom: clamp(-118px, -6.8vw, -76px);
    pointer-events: none;
  }
  .hero-leaf :global(.hero-leaf-mark) {
    width: clamp(330px, 29vw, 500px);
  }

  /* the photo is the backdrop for the copy — on a narrow, tall phone the
     text block grows, so give it more room before the green takes over */
  @media (max-width: 760px) {
    .hero-photo {
      height: calc(clamp(620px, 130vw, 940px) + env(safe-area-inset-top, 0px));
    }
    .hero-copy {
      padding-top: calc(clamp(210px, 46vw, 330px) + env(safe-area-inset-top, 0px));
    }
    .hero-leaf :global(.hero-leaf-mark) {
      width: min(330px, 80vw);
    }
  }
</style>
