---
// "Who we work and learn from"; programmes, institutions and communities
// Siren is part of.
//
// STANDING RULE, do not relax without Bea confirming in writing:
//   Naming an organisation here says we work and learn with them. It must not
//   drift into claiming a formalised partnership, and no third-party logo goes
//   in until that organisation has agreed to appear; a logo reads as
//   endorsement in a way a sentence does not. The `logo` slot below is wired
//   and empty on purpose.
const entries = [
  {
    name: "Tech Foundry Portugal",
    kind: "Deep-tech programme",
    body: "Siren is part of the deep-tech programme, where the two-stage model on this site was built out and stress-tested.",
    href: null,
  },
  {
    name: "Universidade Politécnica de Viseu",
    kind: "Polytechnic University of Viseu",
    body: "The region's public university, half an hour from the farm, and where much of the district's agricultural and technical talent is trained. We work and learn with UPV as we build the science programme.",
    href: "https://ipv.pt/en/",
  },
  {
    name: "Omplo",
    kind: "Viseu entrepreneurship hub",
    body: "From Viseu, for Viseu, by Viseu. A twelve-year effort to build a startup ecosystem in Portugal's interior. We take part in that work.",
    href: null,
  },
];
---

<section class='network' aria-labelledby='network-title'>
  <div class='network-head'>
    <h2 id='network-title'>Who we work and learn from</h2>
    <p>
      We would rather name the rooms we learn in than pretend the thinking is
      all ours.
    </p>
  </div>

  <ul class='network-list'>
    {
      entries.map((entry) => (
        <li class='network-item'>
          <div class='network-id'>
            {/* logo slot; intentionally empty until each organisation agrees */}
            <p class='network-kind'>{entry.kind}</p>
            <h3>
              {entry.href ? (
                <a href={entry.href} target='_blank' rel='noopener'>
                  {entry.name}
                </a>
              ) : (
                entry.name
              )}
            </h3>
          </div>
          <p class='network-body'>{entry.body}</p>
        </li>
      ))
    }
  </ul>
</section>

<style>
  .network {
    max-width: 1080px;
    margin: 0 auto;
    padding: clamp(80px, 8vw, 140px) 24px 0;
  }
  .network-head {
    max-width: 52em;
    margin: 0 auto clamp(28px, 3vw, 44px);
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
  }
  .network-head h2 {
    margin: 0;
    font-size: clamp(30px, 3vw, 48px);
    line-height: 1.12;
    color: var(--color-stromboli);
    text-wrap: balance;
  }
  .network-head p {
    margin: clamp(10px, 1vw, 16px) 0 0;
    max-width: 38em;
    font-size: clamp(16px, 1.35vw, 20px);
    line-height: 1.5;
    color: var(--color-te-papa-green);
    text-wrap: pretty;
  }

  .network-list {
    margin: 0;
    padding: 0;
    list-style: none;
    border-top: 1px solid rgba(47, 99, 87, 0.2);
  }
  .network-item {
    display: grid;
    grid-template-columns: minmax(200px, 1fr) 2fr;
    gap: clamp(10px, 2.4vw, 40px);
    padding: clamp(20px, 2.4vw, 32px) clamp(4px, 1vw, 12px);
    border-bottom: 1px solid rgba(47, 99, 87, 0.2);
  }
  .network-kind {
    margin: 0 0 6px;
    font-size: clamp(12px, 1vw, 14px);
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--color-aquamarine);
  }
  .network-item h3 {
    margin: 0;
    font-size: clamp(21px, 1.9vw, 28px);
    line-height: 1.18;
    color: var(--color-stromboli);
    text-wrap: pretty;
  }
  .network-item h3 a {
    color: inherit;
    text-decoration: none;
    border-bottom: 1px solid rgba(47, 99, 87, 0.3);
    transition: border-color 200ms ease;
  }
  .network-item h3 a:hover {
    border-color: var(--color-stromboli);
  }
  .network-body {
    margin: 0;
    align-self: center;
    font-size: clamp(15px, 1.3vw, 18px);
    line-height: 1.55;
    color: rgba(31, 63, 55, 0.82);
    text-wrap: pretty;
  }

  @media (max-width: 860px) {
    .network-item {
      grid-template-columns: 1fr;
      gap: 10px;
    }
  }
</style>
