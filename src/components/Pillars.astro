---
import GlassCard from "./GlassCard.astro";

// Four claims that hold for every crop and every client.
const pillars = [
  {
    title: "We check the ground",
    paragraphs: [
      "Somebody walks out and looks. Every alert gets checked in the field, blind, and so do places the model said were fine, because otherwise you never find out what it missed. Each model is scored on both.",
    ],
  },
  {
    title: "Plant by plant",
    paragraphs: [
      "A satellite pixel covers several plants and the soil between them, so a block average quietly hides the one tree that is dying. We keep a record for each plant instead: where it is, how it has done, what has been done to it.",
    ],
  },
  {
    title: "Open data first, then our own",
    paragraphs: [
      "We can tell you a surprising amount about a farm before setting foot on it, from public satellite, terrain and weather records. Then we come out, and field checks, drones and sensors fill in everything open data cannot see.",
    ],
  },
  {
    title: "Tested on our land first",
    paragraphs: [
      "We own our land in Tondela, which means we can afford to be wrong on it. Every new tool and sensor runs there first, at our own cost, before it goes near a client\'s crop.",
    ],
  },
];
---

<section class='pillars' aria-labelledby='pillars-title'>
  <div class='pillars-header'>
    <h2 id='pillars-title'>Why this works</h2>
    <p>Four things that hold for every crop and every client.</p>
  </div>

  <div id='pillar-grid'>
    {
      pillars.map((pillar) => (
        <GlassCard>
          <div class='pillar-body'>
            <h3>{pillar.title}</h3>
            {pillar.paragraphs.map((paragraph) => (
              <p>{paragraph}</p>
            ))}
          </div>
        </GlassCard>
      ))
    }
  </div>
</section>

<style>
  .pillars {
    padding: clamp(96px, 10vw, 168px) 0 0;
  }
  .pillars-header {
    max-width: 52em;
    margin: 0 auto clamp(36px, 4vw, 60px);
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
  }
  .pillars-header h2 {
    margin: 0;
    font-size: clamp(36px, 3.2vw, 52px);
    line-height: 1.12;
    color: var(--color-saffron-mango);
  }
  .pillars-header p {
    margin: clamp(10px, 1vw, 16px) 0 0;
    max-width: 34em;
    font-size: clamp(17px, 1.45vw, 22px);
    line-height: 1.5;
    color: var(--color-white);
    text-wrap: pretty;
  }

  #pillar-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: clamp(20px, 2.2vw, 32px);
  }
  @media (max-width: 760px) {
    #pillar-grid {
      grid-template-columns: 1fr;
    }
  }
  .pillar-body {
    display: flex;
    flex-direction: column;
    gap: 20px;
  }
  .pillar-body h3 {
    margin: 0;
    font-size: clamp(28px, 2.4vw, 36px);
    line-height: 1.25;
    color: var(--color-saffron-mango);
  }
  .pillar-body p {
    margin: 0;
    font-size: clamp(16px, 1.5vw, 20px);
    line-height: 1.4;
    color: var(--color-white);
  }
</style>
