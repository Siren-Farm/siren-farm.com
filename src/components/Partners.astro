---
import { Image } from "astro:assets";
import airv from "../assets/partners/airv.svg";
import upv from "../assets/partners/upv.png";
import viteb from "../assets/partners/viteb.svg";

// Partners and recognition, on /about. Moved off the home page in
// November 2026. Rules:
//  . a partner is described as "signed" only when an agreement is signed
//  . each logo uses the organisation's own published dark or colour file,
//    never a white-on-dark variant (invisible on the cream page)
//  . a logo reads as endorsement, so only organisations that agreed appear
const partners = [
  { name: "Universidade Politécnica de Viseu", note: "Collaboration protocol signed" },
  { name: "ViTEB, Visabeira's testbed", note: "Testbed agreement signed" },
  { name: "AIRV, Associação Empresarial da Região de Viseu", note: "Endorses our work" },
];

const recognition = [
  { name: "AI Summit Barcelona 2026", note: "One of five finalists in the Pitch Competition" },
  { name: "2080 Ventures", note: "Selected for the Global Startup Showcase 2026" },
  { name: "Tech Foundry Portugal", note: "Deep-tech edition" },
];

const logos = [
  { src: airv, alt: "AIRV, Associação Empresarial da Região de Viseu" },
  { src: upv, alt: "Universidade Politécnica de Viseu" },
  { src: viteb, alt: "ViTEB, Visabeira's testbed" },
];
---

<section class='partners' aria-labelledby='partners-title'>
  <h2 id='partners-title'>Partners</h2>

  <div class='lists'>
    <div>
      <h3>Who we work with</h3>
      <ul>
        {
          partners.map((item) => (
            <li>
              <span class='name'>{item.name}</span>
              <span class='note'>{item.note}</span>
            </li>
          ))
        }
      </ul>
    </div>
    <div>
      <h3>Recognition</h3>
      <ul>
        {
          recognition.map((item) => (
            <li>
              <span class='name'>{item.name}</span>
              <span class='note'>{item.note}</span>
            </li>
          ))
        }
      </ul>
    </div>
  </div>

  <ul class='logos'>
    {
      logos.map((logo) => (
        <li>
          <Image src={logo.src} alt={logo.alt} height={60} densities={[1, 2]} />
        </li>
      ))
    }
  </ul>
</section>

<style>
  .partners {
    max-width: 1080px;
    margin: 0 auto;
    padding: clamp(80px, 8vw, 140px) 24px 0;
  }
  h2 {
    margin: 0 0 clamp(28px, 3vw, 44px);
    text-align: center;
    font-size: clamp(30px, 3vw, 48px);
    line-height: 1.12;
    color: var(--color-stromboli);
  }

  .lists {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: clamp(28px, 4vw, 64px);
    border-top: 1px solid rgba(47, 99, 87, 0.2);
    padding-top: clamp(24px, 2.6vw, 36px);
  }
  h3 {
    margin: 0 0 14px;
    font-family: var(--font-sans);
    font-size: clamp(12px, 1vw, 14px);
    font-weight: 400;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--color-stromboli);
  }
  .lists ul {
    margin: 0;
    padding: 0;
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 14px;
  }
  .lists li {
    display: flex;
    flex-direction: column;
    gap: 2px;
  }
  .name {
    font-family: var(--font-display);
    font-size: clamp(18px, 1.5vw, 22px);
    line-height: 1.25;
    color: var(--color-te-papa-green);
  }
  .note {
    font-size: clamp(15px, 1.2vw, 17px);
    line-height: 1.45;
    color: rgba(31, 63, 55, 0.78);
  }

  .logos {
    margin: clamp(40px, 4.5vw, 64px) 0 0;
    padding: clamp(28px, 3vw, 44px) 0 0;
    list-style: none;
    border-top: 1px solid rgba(47, 99, 87, 0.2);
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: clamp(28px, 5vw, 72px);
  }
  .logos li {
    display: flex;
  }
  /* height-matched, so marks of different proportions read as one row */
  .logos :global(img) {
    height: clamp(34px, 3.4vw, 50px);
    width: auto;
  }

  @media (max-width: 700px) {
    .lists {
      grid-template-columns: 1fr;
    }
  }
  @media (max-width: 560px) {
    .logos {
      gap: 26px 32px;
    }
    .logos :global(img) {
      height: 30px;
    }
  }
</style>
