---
import Logo from "./Logo.astro";

// Shared sticky nav: transparent over the page at top, condenses into a
// floating frosted capsule once scrolled, tucks away scrolling down and
// glides back the moment you scroll up.
//  - "dark"  sits on the green pages (gold leaf, cream pills)
//  - "light" sits on the cream pages (green leaf, green pills)
// Below 960px the pills collapse into a full-screen drawer, which a phone
// cannot fit next to the wordmark.
interface Props {
  variant?: "dark" | "light";
  /** omitted on pages that are not in the menu, e.g. 404 */
  active?: "home" | "technology" | "why" | "about";
}

const { variant = "dark", active } = Astro.props;

const links = [
  { href: "/", label: "Home", key: "home" },
  { href: "/technology/", label: "Technology", key: "technology" },
  { href: "/why/", label: "Why", key: "why" },
  { href: "/about/", label: "About", key: "about" },
];
---

<div id='site-nav-wrap' class={`nav-${variant}`}>
  <nav id='site-nav' aria-label='Main'>
    <div class='nav-bg' aria-hidden='true'></div>
    <a class='nav-brand' href='/'>
      <Logo tone={variant === "dark" ? "gold" : "dark"} class='nav-leaf' />
      <span>Siren</span>
    </a>

    <div class='nav-links'>
      {
        links.map((link) => (
          <a
            class:list={["nav-pill", { active: active === link.key }]}
            href={link.href}
            aria-current={active === link.key ? "page" : undefined}
          >
            {link.label}
          </a>
        ))
      }
    </div>

    <button
      id='nav-toggle'
      class='nav-toggle'
      type='button'
      aria-expanded='false'
      aria-controls='nav-drawer'
      aria-label='Open menu'
    >
      <span class='bar bar-1'></span>
      <span class='bar bar-2'></span>
    </button>
  </nav>
</div>

<div id='nav-drawer' class={`nav-drawer nav-${variant}`} hidden>
  <nav aria-label='Main mobile'>
    {
      links.map((link) => (
        <a
          class:list={["drawer-link", { active: active === link.key }]}
          href={link.href}
          aria-current={active === link.key ? "page" : undefined}
        >
          {link.label}
        </a>
      ))
    }
    <a class='drawer-mail' href='mailto:hi@siren-farm.com'>hi@siren-farm.com</a>
  </nav>
</div>

<style>
  #site-nav-wrap {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    z-index: 50;
    padding: env(safe-area-inset-top, 0px) clamp(12px, 2vw, 24px) 0;
    transition: transform 380ms cubic-bezier(0.22, 1, 0.36, 1);
  }
  #site-nav-wrap.nav-hidden {
    transform: translateY(-115%);
  }
  #site-nav {
    position: relative;
    max-width: 1556px;
    margin: 0 auto;
    display: flex;
    flex-wrap: nowrap;
    align-items: center;
    justify-content: flex-end;
    gap: 12px;
    padding: clamp(14px, 1.6vw, 22px) clamp(14px, 1.8vw, 26px);
    border-radius: 999px;
    transition:
      margin 320ms ease,
      padding 320ms ease;
  }
  #site-nav-wrap.nav-scrolled #site-nav {
    margin-top: 12px;
    padding: 10px clamp(14px, 1.8vw, 26px);
  }
  /* the capsule glass lives on an absolute child: iOS Safari samples fixed
     elements near the top edge to tint the status bar, but skips absolutely
     positioned children; keeping the photo composited behind the island */
  .nav-bg {
    position: absolute;
    inset: 0;
    z-index: -1;
    border-radius: 999px;
    background: transparent;
    transition:
      background 320ms ease,
      box-shadow 320ms ease;
  }
  #site-nav-wrap.nav-scrolled .nav-bg {
    -webkit-backdrop-filter: blur(20px);
    backdrop-filter: blur(20px);
  }
  .nav-dark.nav-scrolled .nav-bg {
    background: var(--color-glass);
    box-shadow: 0 16px 60px rgba(31, 63, 55, 0.18);
  }
  .nav-light.nav-scrolled .nav-bg {
    background: rgba(255, 255, 255, 0.45);
    box-shadow: 0 16px 60px rgba(31, 63, 55, 0.16);
  }

  .nav-brand {
    margin-right: auto;
    display: inline-flex;
    align-items: center;
    gap: 14px;
    text-decoration: none;
  }
  .nav-brand :global(.nav-leaf) {
    width: 38px;
    flex: 0 0 auto;
  }
  .nav-brand span {
    font-family: var(--font-display);
    font-size: 22px;
    line-height: 1;
    letter-spacing: 0.04em;
  }
  .nav-dark .nav-brand span {
    color: var(--color-putty);
  }
  .nav-light .nav-brand span {
    color: var(--color-te-papa-green);
  }

  .nav-links {
    display: flex;
    align-items: center;
    gap: 8px;
  }

  .nav-pill {
    display: inline-flex;
    align-items: center;
    padding: 0.5rem 1.1rem;
    border-radius: 999px;
    border: 1px solid transparent;
    font-size: 1rem;
    line-height: 1.5;
    text-decoration: none;
    white-space: nowrap;
    transition:
      background 250ms ease,
      color 250ms ease;
  }
  .nav-dark .nav-pill {
    border-color: rgba(240, 207, 135, 0.5);
    color: var(--color-rum-swizzle);
  }
  .nav-dark .nav-pill:hover,
  .nav-dark .nav-pill.active {
    border-color: transparent;
    background: var(--color-rum-swizzle);
    color: var(--color-te-papa-green);
  }
  .nav-light .nav-pill {
    border-color: rgba(47, 99, 87, 0.45);
    color: var(--color-te-papa-green);
  }
  .nav-light .nav-pill:hover,
  .nav-light .nav-pill.active {
    border-color: transparent;
    background: var(--color-stromboli);
    color: var(--color-rum-swizzle);
  }

  /* ── hamburger ─────────────────────────────────────────────── */
  .nav-toggle {
    display: none;
    position: relative;
    width: 46px;
    height: 46px;
    padding: 0;
    border-radius: 999px;
    border: 1px solid transparent;
    background: transparent;
    cursor: pointer;
    flex: 0 0 auto;
  }
  .nav-dark .nav-toggle {
    border-color: rgba(240, 207, 135, 0.5);
  }
  .nav-light .nav-toggle {
    border-color: rgba(47, 99, 87, 0.45);
  }
  .bar {
    position: absolute;
    left: 50%;
    width: 20px;
    height: 2px;
    border-radius: 2px;
    transform: translateX(-50%);
    transition:
      transform 280ms cubic-bezier(0.22, 1, 0.36, 1),
      opacity 200ms ease;
  }
  .nav-dark .bar {
    background: var(--color-rum-swizzle);
  }
  .nav-light .bar {
    background: var(--color-te-papa-green);
  }
  .bar-1 {
    top: 18px;
  }
  .bar-2 {
    top: 26px;
  }
  .nav-toggle[aria-expanded="true"] .bar-1 {
    transform: translateX(-50%) translateY(4px) rotate(45deg);
  }
  .nav-toggle[aria-expanded="true"] .bar-2 {
    transform: translateX(-50%) translateY(-4px) rotate(-45deg);
  }

  /* ── drawer ────────────────────────────────────────────────── */
  .nav-drawer {
    position: fixed;
    inset: 0;
    z-index: 45;
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    gap: clamp(10px, 2.4vh, 20px);
    padding: calc(96px + env(safe-area-inset-top, 0px)) 24px 48px;
    -webkit-backdrop-filter: blur(28px);
    backdrop-filter: blur(28px);
    opacity: 0;
    transition: opacity 260ms ease;
  }
  .nav-drawer[hidden] {
    display: none;
  }
  .nav-drawer.open {
    opacity: 1;
  }
  .nav-drawer.nav-dark {
    background: rgba(31, 63, 55, 0.93);
  }
  .nav-drawer.nav-light {
    background: rgba(245, 245, 225, 0.95);
  }
  .nav-drawer nav {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: clamp(10px, 2.4vh, 20px);
    width: 100%;
  }
  .drawer-link {
    font-family: var(--font-display);
    font-size: clamp(30px, 8vw, 44px);
    line-height: 1.15;
    text-decoration: none;
    transition: color 200ms ease;
  }
  .nav-drawer.nav-dark .drawer-link {
    color: var(--color-rum-swizzle);
  }
  .nav-drawer.nav-dark .drawer-link.active {
    color: var(--color-saffron-mango);
  }
  .nav-drawer.nav-light .drawer-link {
    color: var(--color-te-papa-green);
  }
  .nav-drawer.nav-light .drawer-link.active {
    color: var(--color-stromboli);
  }
  .drawer-mail {
    margin-top: clamp(16px, 4vh, 36px);
    font-size: 18px;
    text-decoration: underline;
    text-underline-offset: 5px;
  }
  .nav-drawer.nav-dark .drawer-mail {
    color: var(--color-putty);
  }
  .nav-drawer.nav-light .drawer-mail {
    color: var(--color-stromboli);
  }

  @media (max-width: 960px) {
    .nav-links {
      display: none;
    }
    .nav-toggle {
      display: block;
    }
  }
  @media (max-width: 420px) {
    .nav-brand :global(.nav-leaf) {
      width: 32px;
    }
    .nav-brand span {
      font-size: 19px;
    }
  }
  /* a short landscape phone cannot centre the links; let it scroll */
  @media (max-height: 520px) {
    .nav-drawer {
      justify-content: flex-start;
      overflow-y: auto;
    }
  }
</style>

<script>
  const wrap = document.getElementById("site-nav-wrap")!;
  const toggle = document.getElementById("nav-toggle")!;
  const drawer = document.getElementById("nav-drawer")!;
  let lastY = window.scrollY;

  const onScroll = () => {
    // while the drawer is open the page behind is locked; ignore scroll
    if (drawer.classList.contains("open")) return;
    const y = window.scrollY;
    wrap.classList.toggle("nav-scrolled", y > 64);
    if (y < 320) wrap.classList.remove("nav-hidden");
    else if (y > lastY + 6) wrap.classList.add("nav-hidden");
    else if (y < lastY - 6) wrap.classList.remove("nav-hidden");
    lastY = y;
  };

  const setDrawer = (open: boolean) => {
    toggle.setAttribute("aria-expanded", String(open));
    toggle.setAttribute("aria-label", open ? "Close menu" : "Open menu");
    document.body.style.overflow = open ? "hidden" : "";
    if (open) {
      drawer.hidden = false;
      // let the browser paint the hidden state before fading in
      requestAnimationFrame(() => drawer.classList.add("open"));
      wrap.classList.remove("nav-hidden");
    } else {
      drawer.classList.remove("open");
      setTimeout(() => {
        if (!drawer.classList.contains("open")) drawer.hidden = true;
      }, 260);
    }
  };

  toggle.addEventListener("click", () =>
    setDrawer(toggle.getAttribute("aria-expanded") !== "true")
  );
  document.addEventListener("keydown", (event) => {
    if (event.key === "Escape" && drawer.classList.contains("open")) {
      setDrawer(false);
      toggle.focus();
    }
  });
  // a tap on any drawer link navigates; clear the lock so a bfcache
  // restore never leaves the body frozen
  drawer.addEventListener("click", (event) => {
    if ((event.target as HTMLElement).closest("a")) setDrawer(false);
  });
  window.addEventListener("pageshow", () => {
    document.body.style.overflow = "";
  });
  // the drawer is a phone affordance; drop it if the viewport grows
  window.matchMedia("(min-width: 961px)").addEventListener("change", (event) => {
    if (event.matches && drawer.classList.contains("open")) setDrawer(false);
  });

  window.addEventListener("scroll", onScroll, { passive: true });
  onScroll();
</script>
