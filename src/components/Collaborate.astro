---
import GlassCard from "./GlassCard.astro";

const audiences = [
  {
    title: "Growers and estates",
    paragraphs: [
      "Start with a short pilot: a first map of your farm from open data, checked on the ground, with our tools running on your land. You see what we get right and what we miss, then we decide together whether to run a full season.",
    ],
  },
  {
    title: "Research and breeding partners",
    paragraphs: [
      "We are building a genetic and environmental record that tracks genotype, phenotype and conditions plant by plant. We welcome research collaborations, joint programmes and field trials under formal agreement.",
    ],
  },
  {
    title: "Investors",
    paragraphs: [
      "We are building the intelligence layer for high-value crops, with a client pilot running and our own land to test on. Write to us for the deck.",
    ],
  },
  {
    title: "Pharmaceutical buyers",
    paragraphs: [
      "Once our INFARMED licence is issued, our research farm will grow outdoor medical cannabis flower to EU-GACP, aiming at EU-GMP compatibility through controlled post-harvest curing. Talk to us about supply.",
    ],
  },
];
---

<div class='collab'>
  <div class='collab-header'>
    <h2>How we work with people</h2>
    <p>Growers first, and everyone who helps us get there.</p>
  </div>

  <div id='collab-grid'>
    {
      audiences.map((audience) => (
        <GlassCard>
          <div class='collab-body'>
            <h3>{audience.title}</h3>
            {audience.paragraphs.map((paragraph) => (
              <p>{paragraph}</p>
            ))}
          </div>
        </GlassCard>
      ))
    }
  </div>
</div>

<style>
  /* a new topic begins here; major section break */
  .collab {
    padding: clamp(96px, 10vw, 168px) 0 0;
  }
  .collab-header {
    max-width: 52em;
    margin: 0 auto;
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: 14px;
  }
  .collab-header h2 {
    margin: 0;
    font-size: clamp(36px, 3.2vw, 52px);
    line-height: 1.12;
    color: var(--color-saffron-mango);
  }
  .collab-header p {
    margin: clamp(6px, 1vw, 14px) 0 0;
    max-width: 36em;
    font-size: clamp(17px, 1.45vw, 22px);
    line-height: 1.5;
    color: var(--color-white);
    text-wrap: pretty;
  }
  #collab-grid {
    margin-top: clamp(36px, 4vw, 60px);
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: clamp(20px, 2.2vw, 32px);
    align-items: stretch;
  }
  @media (max-width: 860px) {
    #collab-grid {
      grid-template-columns: 1fr;
    }
  }
  .collab-body {
    display: flex;
    flex-direction: column;
    gap: 18px;
  }
  .collab-body h3 {
    margin: 0;
    font-size: clamp(28px, 2.4vw, 36px);
    line-height: 1.25;
    color: var(--color-saffron-mango);
  }
  .collab-body p {
    margin: 0;
    font-size: clamp(16px, 1.5vw, 20px);
    line-height: 1.4;
    color: var(--color-white);
  }
</style>
