---
// Where Siren has turned up. Keep it simple: host, one line, link out.
//
// Paste LinkedIn URLs with the query string removed. The share links carry
// utm_source and an rcm= member identifier that should not be published.
const appearances = [
  {
    host: "AJAP",
    title: "National agriculture fair, Santarém",
    note: "Beatriz with the young farmers association at the national fair.",
    href: "https://www.linkedin.com/posts/ajap-associa%C3%A7%C3%A3o-dos-jovens-agricultores-de-portugal-14b048268_ajap-jovensagricultores-jovensempresaerriosrurais-ugcPost-7477472949252468737-qMPI/",
  },
  {
    host: "omplo",
    title: "Talk & Build, Viseu",
    note: "Siren at the session.",
    href: "https://www.linkedin.com/posts/omplo_omplo-talkandbuild-viseu-activity-7415468124541530112-tWMH",
  },
  {
    host: "omplo",
    title: "Talk & Build announcement",
    note: "The line-up, before the night.",
    href: "https://www.linkedin.com/posts/omplo_viseu-activity-7409165673622487040-e-SE",
  },
  {
    host: "Startup Portugal",
    title: "Tech Foundry Portugal opening",
    note: "The deep-tech programme gets under way.",
    href: "https://www.linkedin.com/posts/startupportugal_techfoundryportugal-deeptech-activity-7503497472464584704-f6Dv",
  },
];
---

<section class='out' aria-labelledby='out-title'>
  <div class='out-head'>
    <h2 id='out-title'>Out and about</h2>
    <p>Where we have turned up lately.</p>
  </div>

  <ul class='out-list'>
    {
      appearances.map((item) => (
        <li>
          <a href={item.href} target='_blank' rel='noopener'>
            <span class='out-host'>{item.host}</span>
            <span class='out-title'>{item.title}</span>
            <span class='out-note'>{item.note}</span>
            <span class='out-cue' aria-hidden='true'>
              LinkedIn
            </span>
          </a>
        </li>
      ))
    }
  </ul>
</section>

<style>
  .out {
    max-width: 1080px;
    margin: 0 auto;
    padding: clamp(80px, 8vw, 140px) 24px 0;
  }
  .out-head {
    margin: 0 auto clamp(24px, 2.6vw, 38px);
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
  }
  .out-head h2 {
    margin: 0;
    font-size: clamp(30px, 3vw, 48px);
    line-height: 1.12;
    color: var(--color-stromboli);
  }
  .out-head p {
    margin: 10px 0 0;
    font-size: clamp(16px, 1.35vw, 20px);
    line-height: 1.5;
    color: var(--color-te-papa-green);
  }

  .out-list {
    margin: 0;
    padding: 0;
    list-style: none;
    border-top: 1px solid rgba(47, 99, 87, 0.2);
  }
  .out-list li {
    border-bottom: 1px solid rgba(47, 99, 87, 0.2);
  }
  .out-list a {
    display: grid;
    grid-template-columns: minmax(130px, 0.7fr) minmax(200px, 1.3fr) 1.6fr auto;
    align-items: baseline;
    gap: clamp(10px, 2.2vw, 32px);
    padding: clamp(16px, 1.9vw, 24px) clamp(4px, 1vw, 12px);
    text-decoration: none;
    transition: background 220ms ease;
  }
  .out-list a:hover {
    background: rgba(255, 255, 255, 0.5);
  }
  .out-host {
    font-size: clamp(12px, 1vw, 14px);
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--color-aquamarine);
  }
  .out-title {
    font-family: var(--font-display);
    font-size: clamp(19px, 1.7vw, 25px);
    line-height: 1.2;
    color: var(--color-stromboli);
    text-wrap: pretty;
  }
  .out-note {
    font-size: clamp(14px, 1.2vw, 16px);
    line-height: 1.5;
    color: rgba(31, 63, 55, 0.75);
    text-wrap: pretty;
  }
  .out-cue {
    font-size: clamp(12px, 1.05vw, 14px);
    white-space: nowrap;
    color: var(--color-aquamarine);
    opacity: 0;
    transition: opacity 220ms ease;
  }
  .out-list a:hover .out-cue,
  .out-list a:focus-visible .out-cue {
    opacity: 1;
  }

  @media (max-width: 900px) {
    .out-list a {
      grid-template-columns: 1fr;
      gap: 5px;
    }
    /* no hover on touch, so the cue stays visible */
    .out-cue {
      opacity: 1;
      margin-top: 3px;
    }
  }
</style>
