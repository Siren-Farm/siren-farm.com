---
import { STATUS_AS_OF, PLANTOLOGIST, cropsPhrase } from "../data/facts";

// Dated public status. Hard rules, do not soften:
//  . the INFARMED cultivation licence is SUBMITTED, never "granted" or
//    "licensed", and it covers medical cannabis only
//  . no projections: no revenue, EBITDA, yield or market-share figures
//  . a partner is named only once an agreement is signed
//  . no figure for what friends and family put in
const asOf = STATUS_AS_OF;

const items = [
  {
    label: "Clients",
    value:
      "First client pilot running since October 2026, using our tools on a commercial farm.",
  },
  {
    label: "Technology",
    value: `Plantologist and Pluvora are trained on ${cropsPhrase}. Plantologist detects disease from any camera, with ${PLANTOLOGIST.top1} top-1 accuracy across ${PLANTOLOGIST.diseaseClasses} disease classes, ${PLANTOLOGIST.measuredOn}. Pluvora, the intelligence layer of Sprout Heavy, decides when to irrigate and when to act. Sprout Heavy uses Copernicus satellite data. Provenance tracing is in development.`,
  },
  {
    label: "Partners",
    value:
      "Collaboration protocol signed with Universidade Politécnica de Viseu. Testbed agreement signed with ViTEB, Visabeira's test bed.",
  },
  {
    label: "Recognition",
    value:
      "One of five finalists in the AI Summit Barcelona 2026 Pitch Competition. Selected for 2080 Ventures' Global Startup Showcase 2026. Tech Foundry Portugal, deep-tech edition. Endorsed by AIRV.",
  },
  {
    label: "Demand",
    value:
      "Expressions of interest from international agri-groups covering about 40,000 hectares.",
  },
  {
    label: "Research farm",
    value:
      "Freehold land in Tondela. INFARMED cultivation licence application filed, not yet issued. Letter of intent from an EU-GMP manufacturer for the farm's output.",
  },
  {
    label: "Funding",
    value:
      "Bootstrapped by the founders, friends and family. Now raising our first external round.",
  },
  {
    label: "Next",
    value:
      "First licensed field season on our research farm planned for 2027, subject to the licence.",
  },
];
---

<section class='status' aria-labelledby='status-title'>
  <div class='status-inner'>
    <div class='status-head'>
      <h2 id='status-title'>Where we are</h2>
      <p class='status-date'>
        <span class='status-dot' aria-hidden='true'></span>
        Updated {asOf}
      </p>
    </div>
    <dl class='status-grid'>
      {
        items.map((item) => (
          <div class='status-item'>
            <dt>{item.label}</dt>
            <dd>{item.value}</dd>
          </div>
        ))
      }
    </dl>
  </div>
</section>

<style>
  .status {
    padding: clamp(56px, 6vw, 96px) 0 0;
  }
  .status-inner {
    border: 1px solid rgba(240, 207, 135, 0.3);
    border-radius: 1.5rem;
    padding: clamp(24px, 2.6vw, 40px);
    background: rgba(255, 255, 255, 0.05);
  }
  .status-head {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: 10px 20px;
  }
  .status-head h2 {
    margin: 0;
    font-size: clamp(24px, 2vw, 32px);
    line-height: 1.2;
    color: var(--color-saffron-mango);
  }
  .status-date {
    margin: 0;
    display: inline-flex;
    align-items: center;
    gap: 9px;
    font-size: clamp(13px, 1.05vw, 15px);
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--color-putty);
  }
  /* a small live dot; the page should feel current, because it is */
  .status-dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--color-saffron-mango);
    box-shadow: 0 0 0 4px rgba(238, 186, 88, 0.18);
  }

  .status-grid {
    margin: clamp(20px, 2.2vw, 30px) 0 0;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(190px, 1fr));
    gap: clamp(18px, 2vw, 30px);
  }
  .status-item dt {
    margin: 0 0 8px;
    font-size: clamp(12px, 1vw, 14px);
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--color-putty);
  }
  .status-item dd {
    margin: 0;
    font-size: clamp(15px, 1.3vw, 18px);
    line-height: 1.45;
    color: var(--color-white);
    text-wrap: pretty;
  }

  @media (max-width: 560px) {
    .status-grid {
      grid-template-columns: 1fr;
      gap: 18px;
    }
    .status-item {
      padding-bottom: 16px;
      border-bottom: 1px solid rgba(240, 207, 135, 0.18);
    }
    .status-item:last-child {
      padding-bottom: 0;
      border-bottom: none;
    }
  }
</style>
