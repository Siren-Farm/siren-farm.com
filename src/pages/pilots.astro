---
import Layout from "../layouts/Layout.astro";
import Nav from "../components/Nav.astro";
import SayHi from "../components/SayHi.astro";
import Footer from "../components/Footer.astro";

// Clients are never named, and no farm is described in enough detail to be
// identified. Keep it that way whatever is added here.
const steps = [
  {
    name: "A first map, before we visit",
    detail:
      "From public satellite imagery, national terrain surveys and weather records, we map your parcels, plants and risk. It shows where to look.",
  },
  {
    name: "Ground truth",
    detail:
      "We check alerts in the field, blind, including places the model rated low risk, so missed cases are counted too. Lab tests confirm what we find.",
  },
  {
    name: "Calibrate",
    detail:
      "Models are tuned to your farm, and we report how many alerts were real (precision) and how many real cases they caught (recall).",
  },
  {
    name: "Record everything",
    detail:
      "Operations, inputs and harvest go into Sprout Heavy, per block and per plant where it matters, so later decisions rest on results.",
  },
  {
    name: "Decide together",
    detail:
      "At the end you have the evidence to decide whether to run a full season with us. How your data is used is agreed in writing before we start.",
  },
];

const mailto =
  "mailto:hi@siren-farm.com?subject=Map%20my%20farm&body=Crop%3A%0AApproximate%20area%20(ha)%3A%0ARegion%3A%0A";
---

<Layout
  title='Pilots | Siren'
  description='How a Siren pilot works: a first map of your farm from open data, checked on the ground, then results you can measure.'
  theme='cream'
>
  <Nav variant='light' active='pilots' />

  <main id='main' class='pilots'>
    <header class='pilots-header'>
      <p class='eyebrow'>Pilots</p>
      <h1>How a pilot works</h1>
      <p class='lede'>
        A short pilot, then a decision taken together. Our first client pilot
        has been running since October 2026.
      </p>
    </header>

    <ol class='steps'>
      {
        steps.map((step, index) => (
          <li class='step'>
            <span class='step-index' aria-hidden='true'>
              {String(index + 1).padStart(2, "0")}
            </span>
            <h2>{step.name}</h2>
            <p>{step.detail}</p>
          </li>
        ))
      }
    </ol>

    <section class='map' id='map' aria-labelledby='map-title'>
      <h2 id='map-title'>Map my farm</h2>
      <p>
        Send us your crop, approximate area and region, and we'll tell you what
        open data can already show about your farm.
      </p>
      <a class='map-cta' href={mailto}>Map my farm</a>
      <p class='map-note'>
        We never name clients or their farms without their written consent.
      </p>
    </section>

    <SayHi variant='cream' />
  </main>
  <Footer variant='cream' />
</Layout>

<style>
  .pilots {
    position: relative;
    z-index: 2;
    max-width: 1080px;
    margin: 0 auto;
    padding: 0 24px;
  }
  .pilots-header {
    padding: calc(clamp(150px, 14vw, 220px) + env(safe-area-inset-top, 0px)) 0 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
  }
  .eyebrow {
    margin: 0 0 clamp(12px, 1.2vw, 18px);
    font-size: clamp(12px, 1.05vw, 15px);
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--color-aquamarine);
  }
  .pilots-header h1 {
    margin: 0;
    font-size: clamp(38px, 4vw, 60px);
    line-height: 1.08;
    color: var(--color-stromboli);
    text-wrap: balance;
  }
  .lede {
    margin: clamp(20px, 2vw, 28px) 0 0;
    max-width: 38em;
    font-size: clamp(17px, 1.45vw, 22px);
    line-height: 1.5;
    color: var(--color-te-papa-green);
    text-wrap: pretty;
  }

  /* numbered steps, styled like the measure rows on the home page */
  .steps {
    margin: clamp(48px, 5vw, 80px) 0 0;
    padding: 0;
    list-style: none;
    border-top: 1px solid rgba(47, 99, 87, 0.22);
  }
  .step {
    display: grid;
    grid-template-columns: auto minmax(150px, 1fr) 2fr;
    align-items: baseline;
    gap: clamp(14px, 2.4vw, 40px);
    padding: clamp(22px, 2.4vw, 32px) clamp(4px, 1vw, 12px);
    border-bottom: 1px solid rgba(47, 99, 87, 0.22);
  }
  .step-index {
    font-family: var(--font-display);
    font-size: clamp(13px, 1.1vw, 16px);
    color: var(--color-aquamarine);
    font-variant-numeric: tabular-nums;
  }
  .step h2 {
    margin: 0;
    font-size: clamp(20px, 1.9vw, 28px);
    line-height: 1.18;
    color: var(--color-stromboli);
    text-wrap: pretty;
  }
  .step p {
    margin: 0;
    font-size: clamp(15px, 1.35vw, 19px);
    line-height: 1.55;
    color: rgba(31, 63, 55, 0.82);
    text-wrap: pretty;
  }

  .map {
    margin-top: clamp(64px, 7vw, 110px);
    border-radius: 1.5rem;
    padding: clamp(28px, 3.2vw, 48px);
    background: var(--color-stromboli);
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    /* the nav is sticky, so an anchor jump needs clearance */
    scroll-margin-top: 110px;
  }
  .map h2 {
    margin: 0;
    font-size: clamp(28px, 2.6vw, 40px);
    line-height: 1.15;
    color: var(--color-saffron-mango);
  }
  .map p {
    margin: clamp(12px, 1.2vw, 18px) 0 0;
    max-width: 40em;
    font-size: clamp(16px, 1.35vw, 19px);
    line-height: 1.55;
    color: var(--color-white);
    text-wrap: pretty;
  }
  .map-cta {
    margin-top: clamp(20px, 2.2vw, 30px);
    display: inline-flex;
    align-items: center;
    padding: 0.8rem 1.8rem;
    border-radius: 999px;
    background: var(--color-saffron-mango);
    color: var(--color-te-papa-green);
    font-size: clamp(16px, 1.3vw, 19px);
    text-decoration: none;
    transition: background 250ms ease;
  }
  .map-cta:hover {
    background: var(--color-putty);
  }
  .map-note {
    margin-top: clamp(16px, 1.8vw, 24px);
    font-size: clamp(13px, 1.1vw, 15px);
    color: var(--color-rum-swizzle);
    opacity: 0.8;
  }

  @media (max-width: 900px) {
    .step {
      grid-template-columns: auto 1fr;
      gap: 8px clamp(12px, 3vw, 20px);
      align-items: start;
    }
    .step h2 {
      align-self: center;
    }
    .step p {
      grid-column: 2;
    }
  }
</style>
