---
import Layout from "../layouts/Layout.astro";
import Nav from "../components/Nav.astro";
import SayHi from "../components/SayHi.astro";
import Footer from "../components/Footer.astro";

// Products are named but never implied to ship. Each carries an explicit
// stage. A named roadmap with honest dates is not the same thing as a claim,
// and the distinction is the whole reason this page is credible.
const products = [
  {
    name: "Sprout Heavy",
    domain: "Cultivation intelligence",
    stage: "In development · first field trials 2027",
    body: "Genotype, sensor and season data fused into cultivation decisions — what to plant where, when to intervene, and what the crop is likely to express. It is the layer that turns our genomics work into something a grower can act on in the morning.",
  },
  {
    name: "Pluvora",
    domain: "Water and irrigation",
    stage: "In development · first field trials 2027",
    body: "Irrigation control that coordinates pumps, filters, mixers and sensor data against soil moisture and forecast, optimising water and nutrient delivery rather than merely scheduling it. Built on infrastructure our CTO has already run at 10,000-hectare scale.",
  },
  {
    name: "Plantologist",
    domain: "Plant health and propagation",
    stage: "In development · first field trials 2027",
    body: "Imaging and diagnostics for plant health, vigour and propagation quality — from verifying that a mother line has not drifted, through to grading nursery and reforestation stock.",
  },
];

const markets = [
  {
    name: "Medical cannabis producers",
    body: "Traceability, chemotype consistency and clone verification, under the regime we operate in ourselves.",
  },
  {
    name: "Smallholders and growers",
    body: "The decision layer, priced for farms that were never going to buy an enterprise agronomy platform.",
  },
  {
    name: "Nurseries and reforestation",
    body: "Propagation quality and plant-health grading at the point where a bad batch is cheapest to catch.",
  },
  {
    name: "Turf and sports grounds",
    body: "Water intelligence for managed grass, where irrigation is the dominant cost and the dominant footprint.",
  },
];
---

<Layout
  title='Technology — what Siren is building'
  description='Sprout Heavy, Pluvora and Plantologist: the cultivation, water and plant-health systems Siren is building, trained and field-tested on its own crop in Portugal.'
  theme='cream'
>
  <Nav variant='light' active='technology' />

  <main id='main' class='tech'>
    <header class='tech-header'>
      <p class='eyebrow'>Technology</p>
      <h1>Built on our own crop, at our own risk</h1>
      <p class='lede'>
        Three systems are in development at Siren. Each one is trained and
        field-tested on the farm we own before it is offered to anyone else —
        which means we carry the cost of being wrong first.
      </p>
    </header>

    <section class='products' aria-labelledby='products-title'>
      <h2 id='products-title' class='visually-hidden'>Products in development</h2>
      {
        products.map((product) => (
          <article class='product'>
            <div class='product-side'>
              <p class='product-domain'>{product.domain}</p>
              <h3>{product.name}</h3>
              <p class='product-stage'>{product.stage}</p>
            </div>
            <p class='product-body'>{product.body}</p>
          </article>
        ))
      }
    </section>

    <section class='honesty' aria-labelledby='honesty-title'>
      <h2 id='honesty-title'>What is not true yet</h2>
      <p>
        None of these are in general release. None have external customers. No
        pricing is published because nothing is for sale. First trials run in
        2027, on our own crop, and we will say plainly how they went.
      </p>
      <p>
        We would rather name the roadmap and date it than describe capabilities
        in the present tense and hope nobody asks.
      </p>
    </section>

    <section class='markets' aria-labelledby='markets-title'>
      <div class='markets-head'>
        <h2 id='markets-title'>Where it goes beyond cannabis</h2>
        <p>
          Almost nothing we are building is species-specific. Cannabis is where
          it gets trained hardest — under a traceability regime that keeps us
          honest — but a model of how a genotype behaves across a season does
          not care what is in the ground.
        </p>
      </div>
      <ul class='market-grid'>
        {
          markets.map((market) => (
            <li>
              <h3>{market.name}</h3>
              <p>{market.body}</p>
            </li>
          ))
        }
      </ul>
    </section>

    <SayHi variant='cream' />
  </main>
  <Footer variant='cream' />
</Layout>

<style>
  .tech {
    position: relative;
    z-index: 2;
    max-width: 1280px;
    margin: 0 auto;
    padding: 0 24px;
  }

  .tech-header {
    max-width: 1080px;
    margin: 0 auto;
    padding: calc(clamp(150px, 14vw, 220px) + env(safe-area-inset-top, 0px)) 0 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
  }
  .eyebrow {
    margin: 0 0 clamp(12px, 1.2vw, 18px);
    font-size: clamp(12px, 1.05vw, 15px);
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--color-aquamarine);
  }
  .tech-header h1 {
    margin: 0;
    font-size: clamp(38px, 4vw, 60px);
    line-height: 1.08;
    color: var(--color-stromboli);
    text-wrap: balance;
  }
  .lede {
    margin: clamp(20px, 2vw, 28px) 0 0;
    max-width: 38em;
    font-size: clamp(17px, 1.45vw, 22px);
    line-height: 1.5;
    color: var(--color-te-papa-green);
    text-wrap: pretty;
  }

  .visually-hidden {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip: rect(0 0 0 0);
    white-space: nowrap;
  }

  /* ── products ──────────────────────────────────────────────── */
  .products {
    margin-top: clamp(56px, 6vw, 96px);
    border-top: 1px solid rgba(47, 99, 87, 0.22);
  }
  .product {
    display: grid;
    grid-template-columns: minmax(220px, 1fr) 2fr;
    gap: clamp(18px, 3vw, 56px);
    padding: clamp(28px, 3.2vw, 48px) 0;
    border-bottom: 1px solid rgba(47, 99, 87, 0.22);
  }
  .product-domain {
    margin: 0 0 8px;
    font-size: clamp(12px, 1vw, 14px);
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--color-aquamarine);
  }
  .product-side h3 {
    margin: 0;
    font-size: clamp(28px, 2.8vw, 42px);
    line-height: 1.1;
    color: var(--color-stromboli);
  }
  .product-stage {
    margin: 12px 0 0;
    display: inline-block;
    padding: 6px 13px;
    border-radius: 999px;
    border: 1px dashed rgba(47, 99, 87, 0.45);
    font-size: clamp(12px, 1vw, 14px);
    line-height: 1.3;
    color: var(--color-te-papa-green);
    opacity: 0.85;
  }
  .product-body {
    margin: 0;
    align-self: center;
    font-size: clamp(16px, 1.4vw, 20px);
    line-height: 1.55;
    color: var(--color-te-papa-green);
    text-wrap: pretty;
  }

  /* ── honesty block ─────────────────────────────────────────── */
  .honesty {
    margin-top: clamp(56px, 6vw, 96px);
    border-radius: 1.5rem;
    padding: clamp(26px, 3vw, 44px);
    background: var(--color-stromboli);
  }
  .honesty h2 {
    margin: 0 0 14px;
    font-size: clamp(24px, 2.2vw, 34px);
    line-height: 1.15;
    color: var(--color-saffron-mango);
  }
  .honesty p {
    margin: 0 0 1em;
    max-width: 44em;
    font-size: clamp(16px, 1.35vw, 19px);
    line-height: 1.55;
    color: var(--color-white);
    text-wrap: pretty;
  }
  .honesty p:last-child {
    margin-bottom: 0;
  }

  /* ── markets ───────────────────────────────────────────────── */
  .markets {
    margin-top: clamp(80px, 8vw, 140px);
  }
  .markets-head {
    max-width: 52em;
    margin: 0 auto clamp(30px, 3.4vw, 50px);
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
  }
  .markets-head h2 {
    margin: 0;
    font-size: clamp(30px, 3vw, 48px);
    line-height: 1.12;
    color: var(--color-stromboli);
  }
  .markets-head p {
    margin: clamp(10px, 1vw, 16px) 0 0;
    max-width: 38em;
    font-size: clamp(16px, 1.35vw, 20px);
    line-height: 1.5;
    color: var(--color-te-papa-green);
    text-wrap: pretty;
  }
  .market-grid {
    margin: 0;
    padding: 0;
    list-style: none;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: clamp(20px, 2.2vw, 32px);
  }
  .market-grid li {
    border-radius: 1.5rem;
    padding: clamp(22px, 2.4vw, 34px);
    background: rgba(255, 255, 255, 0.55);
    border: 1px solid rgba(47, 99, 87, 0.16);
  }
  .market-grid h3 {
    margin: 0 0 10px;
    font-size: clamp(20px, 1.8vw, 26px);
    line-height: 1.2;
    color: var(--color-stromboli);
  }
  .market-grid p {
    margin: 0;
    font-size: clamp(15px, 1.3vw, 18px);
    line-height: 1.5;
    color: var(--color-te-papa-green);
    text-wrap: pretty;
  }

  @media (max-width: 860px) {
    .product {
      grid-template-columns: 1fr;
      gap: 14px;
    }
    .market-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
