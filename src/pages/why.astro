---
import Layout from "../layouts/Layout.astro";
import Nav from "../components/Nav.astro";
import SayHi from "../components/SayHi.astro";
import Footer from "../components/Footer.astro";

// One source of truth: the same array renders the page and the FAQPage
// structured data, so search results can never drift from the copy.
//
// Accuracy rules for this file, do not soften:
//  . the INFARMED licence is applied for, never held
//  . no revenue or yield projections
//  . no research partner is named as a partner
const faqs: { q: string; lead?: string; bullets?: string[]; close?: string }[] = [
  {
    q: "Why cannabis?",
    lead: "Three reasons at once.",
    bullets: [
      "A real medical need. Portugal ships out far more medical cannabis than it makes available to its own patients. On our reading of the export and dispensing figures, around 647 times more.",
      "A crop that pays for the instrumentation. Sequencing and sensing never pencil out on a commodity crop. They do on this one, and the methods transfer down afterwards.",
      "An unusually good biological model. Clonal propagation lets us hold a genotype constant while the season varies. The plant gives dozens of measurable cannabinoid and terpene readouts. And pharmaceutical-grade cultivation legally requires the per-plant record that every other agricultural-AI company has to ask a farmer for.",
    ],
    close: "Cannabis is not incidental to Siren, and it is not all of Siren. It is the right first crop.",
  },
  {
    q: "Why outdoors, when almost all medical cannabis is grown indoors?",
    lead: "Because you cannot learn a climate in a sealed room.",
    bullets: [
      "Indoor cultivation exists to remove variance. That variance is what we are trying to model.",
      "Outdoor is far lower-carbon and lower-cost. One crop a year, March to October.",
      "It is harder, and a bad season is a real season. That is why the data is worth having.",
    ],
  },
  {
    q: "So is Siren a farm or a technology company?",
    lead: "Today, honestly: an agriculture company that trains data and tests hardware. Stage one earns from flower. Stage two is platform revenue from the tools the farm proves out, around 2028 to 2029. Four things join the stages.",
    bullets: [
      "Cash. Flower revenue funds the engineering years.",
      "Data. Every season adds labelled records that cannot be bought.",
      "Model training. The farm is the ground truth.",
      "Hardware testing. Sensors run on our own crop first.",
    ],
    close: "The farm is not a side business. It is the instrument.",
  },
  {
    q: "Why Tondela?",
    bullets: [
      "It is home, and the land was securable.",
      "The Dão is a serious growing region. Granite soils, shelter from the Caramulo and Estrela ranges, and a wide swing between day and night temperature. For a plant whose value sits in its volatile chemistry, that swing matters.",
      "The jobs and the spending land in a part of Portugal that needs them.",
    ],
  },
  {
    q: "Why should anyone who doesn't grow cannabis care?",
    lead: "Almost nothing we are building is cannabis-specific. Three systems are in development.",
    bullets: [
      "Sprout Heavy. Cultivation intelligence.",
      "Pluvora. Water and irrigation.",
      "Plantologist. Plant health and propagation.",
    ],
    close: "All three are pre-release, with first field trials in 2027 on our own crop. The methods transfer to medicinal plants, hops and aromatics, and the water and plant-health work reaches into nurseries, reforestation and managed turf.",
  },
  {
    q: "Is Siren licensed?",
    lead: "No, and we will not say we are until we are. Our cultivation licence application is filed with INFARMED, Portugal's medicines regulator. It has been submitted. It has not been issued. We plan for delay rather than assuming approval.",
  },
];

const schema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: faqs.map((faq) => ({
    "@type": "Question",
    name: faq.q,
    acceptedAnswer: {
      "@type": "Answer",
      text: [faq.lead, ...(faq.bullets ?? []), faq.close].filter(Boolean).join(" "),
    },
  })),
};
---

<Layout
  title='Why cannabis, why outdoors, why Tondela | Siren'
  description='Straight answers on why Siren grows medical cannabis outdoors in the Dão, what it is building beyond the crop, and what exists today.'
  theme='cream'
  schema={schema}
>
  <Nav variant='light' active='why' />

  <main id='main'>
    <header class='why-header'>
      <p class='why-eyebrow'>Questions we actually get asked</p>
      <h1>Why cannabis, why outdoors, why here</h1>
      <p class='why-lede'>
        The short version: the crop pays for the science, teaches our models
        faster than anything else we could plant, and is needed by patients in
        the country that grows it.
      </p>
    </header>

    <div class='faq'>
      {
        faqs.map((faq, index) => (
          <details class='faq-item' open={index === 0}>
            <summary>
              <span class='faq-q'>{faq.q}</span>
              <span class='faq-sign' aria-hidden='true' />
            </summary>
            <div class='faq-a'>
              {faq.lead && <p>{faq.lead}</p>}
              {faq.bullets && (
                <ul>
                  {faq.bullets.map((bullet) => (
                    <li>{bullet}</li>
                  ))}
                </ul>
              )}
              {faq.close && <p>{faq.close}</p>}
            </div>
          </details>
        ))
      }
    </div>

    <SayHi variant='cream' />
  </main>
  <Footer variant='cream' />
</Layout>

<style>
  .why-header {
    max-width: 1080px;
    margin: 0 auto;
    padding: calc(clamp(150px, 14vw, 220px) + env(safe-area-inset-top, 0px)) 24px 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
  }
  .why-eyebrow {
    margin: 0 0 clamp(12px, 1.2vw, 18px);
    font-size: clamp(12px, 1.05vw, 15px);
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--color-aquamarine);
  }
  .why-header h1 {
    margin: 0;
    font-size: clamp(38px, 4vw, 60px);
    line-height: 1.08;
    color: var(--color-stromboli);
    text-wrap: balance;
  }
  .why-lede {
    margin: clamp(20px, 2vw, 28px) 0 0;
    max-width: 38em;
    font-size: clamp(17px, 1.45vw, 22px);
    line-height: 1.5;
    color: var(--color-te-papa-green);
    text-wrap: pretty;
  }

  .faq {
    max-width: 960px;
    margin: clamp(48px, 5vw, 80px) auto 0;
    padding: 0 24px;
  }
  .faq-item {
    border-bottom: 1px solid rgba(47, 99, 87, 0.22);
  }
  .faq-item:first-child {
    border-top: 1px solid rgba(47, 99, 87, 0.22);
  }
  summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 20px;
    padding: clamp(20px, 2.2vw, 30px) 0;
    cursor: pointer;
    list-style: none;
  }
  /* Safari still paints its own disclosure triangle without this */
  summary::-webkit-details-marker {
    display: none;
  }
  .faq-q {
    font-family: var(--font-display);
    font-size: clamp(21px, 2.1vw, 32px);
    line-height: 1.2;
    color: var(--color-stromboli);
    text-wrap: pretty;
  }
  /* a plus that becomes a minus, cheaper than an icon and always crisp */
  .faq-sign {
    position: relative;
    flex: 0 0 auto;
    width: 26px;
    height: 26px;
  }
  .faq-sign::before,
  .faq-sign::after {
    content: "";
    position: absolute;
    top: 50%;
    left: 50%;
    background: var(--color-aquamarine);
    transform: translate(-50%, -50%);
    transition: transform 260ms cubic-bezier(0.22, 1, 0.36, 1);
  }
  .faq-sign::before {
    width: 22px;
    height: 2px;
  }
  .faq-sign::after {
    width: 2px;
    height: 22px;
  }
  .faq-item[open] .faq-sign::after {
    transform: translate(-50%, -50%) rotate(90deg);
  }
  .faq-a {
    padding: 0 0 clamp(22px, 2.4vw, 34px);
    max-width: 44em;
  }
  .faq-a p {
    margin: 0 0 1em;
    font-size: clamp(16px, 1.35vw, 19px);
    line-height: 1.6;
    color: var(--color-te-papa-green);
    text-wrap: pretty;
  }
  .faq-a p:last-child {
    margin-bottom: 0;
  }
  .faq-a ul {
    margin: 0 0 1em;
    padding: 0 0 0 1.1em;
    list-style: none;
  }
  .faq-a ul:last-child {
    margin-bottom: 0;
  }
  .faq-a li {
    position: relative;
    margin: 0 0 0.7em;
    font-size: clamp(16px, 1.35vw, 19px);
    line-height: 1.6;
    color: var(--color-te-papa-green);
    text-wrap: pretty;
  }
  .faq-a li:last-child {
    margin-bottom: 0;
  }
  .faq-a li::before {
    content: "";
    position: absolute;
    left: -1.1em;
    top: 0.62em;
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--color-aquamarine);
  }

  @media (max-width: 560px) {
    summary {
      align-items: flex-start;
      gap: 14px;
    }
    .faq-sign {
      margin-top: 4px;
      width: 22px;
      height: 22px;
    }
    .faq-sign::before {
      width: 18px;
    }
    .faq-sign::after {
      height: 18px;
    }
  }
</style>
